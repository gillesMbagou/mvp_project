{
  "realm": "caresync",
  "displayName": "CareSync — Plateforme de Coordination des Soins",
  "enabled": true,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 3600,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "roles": {
    "realm": [
      { "name": "MEDECIN",      "description": "Médecin — accès complet dossier patient" },
      { "name": "INFIRMIER",    "description": "Infirmier — lecture dossier, saisie observations" },
      { "name": "PHARMACIEN",   "description": "Pharmacien — accès prescriptions" },
      { "name": "ADMIN",        "description": "Administrateur établissement" },
      { "name": "COORDINATEUR", "description": "Coordinateur de soins — plans de soins" }
    ]
  },
  "clients": [
    {
      "clientId": "caresync-frontend",
      "name": "CareSync Angular Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4200"
      ],
      "webOrigins": ["http://localhost:4200"],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "caresync-backend",
      "name": "CareSync Spring Boot Backend",
      "enabled": true,
      "publicClient": false,
      "secret": "caresync-client-secret-dev",
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "caresync-swagger",
      "name": "Swagger UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8082/*",
        "http://localhost:8081/swagger-ui/*"
      ],
      "webOrigins": ["*"],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "dr.dupont",
      "email": "dr.dupont@caresync.local",
      "firstName": "Jean",
      "lastName": "Dupont",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": ["MEDECIN"]
    },
    {
      "username": "inf.martin",
      "email": "inf.martin@caresync.local",
      "firstName": "Sophie",
      "lastName": "Martin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": ["INFIRMIER"]
    },
    {
      "username": "pharm.durand",
      "email": "pharm.durand@caresync.local",
      "firstName": "Marc",
      "lastName": "Durand",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": ["PHARMACIEN"]
    },
    {
      "username": "admin.caresync",
      "email": "admin@caresync.local",
      "firstName": "Admin",
      "lastName": "CareSync",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }
  ]
}
