# Copier en configmap-prod.env (jamais committé) et substituer depuis les
# GitHub Secrets PROD_* (voir backend-cd-prod.yml) :
#   envsubst < configmap-prod.env.example > configmap-prod.env
DB_HOST=${PROD_DB_HOST}
KAFKA_BROKERS=${PROD_KAFKA_BROKERS}
KEYCLOAK_URL=${PROD_KEYCLOAK_URL}
REDIS_URL=${PROD_REDIS_HOST}
MQTT_HOST=${PROD_MQTT_HOST}
OTEL_EXPORTER_OTLP_ENDPOINT=${PROD_OTEL_ENDPOINT}
QUARKUS_OTEL_LOGS_ENABLED=true
